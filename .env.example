# Copy this file to .env and fill in your own values.
# .env is in .gitignore -- never commit real keys.
#
# Labs 03-10 (local OpenVINO) need NO keys at all.

# --- Lab 01: GPT-6.1 Sol on Microsoft Foundry (Azure OpenAI v1 API) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-key>
AZURE_OPENAI_DEPLOYMENT=gpt-6.1-sol

# --- Lab 02: Claude Opus 5.5 (Anthropic API) ---
ANTHROPIC_API_KEY=<your-claude-key>
